ALTBOT_DISCORD_TOKEN=put-your-discord-bot-token-here
ALTBOT_OWNER_ID=123456789012345678,987654321098765432

# Optional: timezone (business day boundary / market date)
ALTBOT_TIME_ZONE=Asia/Tokyo

# Optional: market model tuning
ALTBOT_MARKET_GBM_MU=0.00002
ALTBOT_MARKET_GBM_SIGMA=0.003
ALTBOT_MARKET_PASSIVE_MIN=0.996
ALTBOT_MARKET_PASSIVE_MAX=1.004
ALTBOT_MARKET_MEAN_REVERSION=0.18

# Optional: rate-limit tuning
ALTBOT_MIN_SAME_COMMAND_INTERVAL_MS=800
ALTBOT_SLASH_WINDOW_SECONDS=5
ALTBOT_MAX_SLASH_PER_WINDOW=8
ALTBOT_COMPONENT_WINDOW_SECONDS=4
ALTBOT_MAX_COMPONENT_PER_WINDOW=12
ALTBOT_CHART_MAX_CONCURRENT=2

# Optional: casino RTP tuning (0.5 - 1.1)
ALTBOT_CASINO_RTP_BLACKJACK=0.959
ALTBOT_CASINO_RTP_CHINCHIRO=0.959
ALTBOT_CASINO_RTP_ROULETTE=0.959
ALTBOT_CASINO_RTP_SLOT=0.959
ALTBOT_CASINO_RTP_POKER=0.959

# Optional: role panel
ALTBOT_ROLE_PANEL_ENABLED=false
# Comma-separated guild IDs. Empty means all guilds.
ALTBOT_ROLE_PANEL_GUILD_IDS=
# Format: role_id|label|description;role_id|label|description
ALTBOT_ROLE_PANEL_ROLES=123456789012345678|Game|Game role;234567890123456789|Notify|Notification role

# Optional: sticky messages (/pin)
# Enabling this makes the bot request the guild message gateway intent, which is
# not privileged and needs no approval in the Discord developer portal.
ALTBOT_STICKY_ENABLED=false
# Seconds of quiet before the sticky is reposted, so bursts of chat collapse
# into a single repost instead of one per message.
ALTBOT_STICKY_DEBOUNCE_SECONDS=5

# Optional: economy
ALTBOT_ECONOMY_ENABLED=false
